# Copy to .env and fill in. NEVER commit .env.
COINDCX_API_KEY=""
COINDCX_API_SECRET=""

# Trading mode: test | paper | live
TRADING_MODE=paper
SYMBOL=B-BTC_USDT
MARGIN_CURRENCY=USDT

# Database
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trader
REDIS_URL=redis://localhost:6379/0

# Risk (percents are fractions of equity, e.g. 0.01 = 1%)
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.05
MAX_DRAWDOWN=0.20
MAX_POSITIONS=3
MAX_LEVERAGE=10
DEFAULT_LEVERAGE=3

# Backtest
MAKER_FEE=0.00025
TAKER_FEE=0.0006
SLIPPAGE_BPS=2.0

# Notifications (optional)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

LOG_LEVEL=INFO