[Unit]
Description=CoinDCX venue recorder (REST poller, funding+basis to coindcx_venue.csv)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Trading
Environment=PYTHONPATH=/home/ubuntu/Trading
ExecStart=/home/ubuntu/Trading/.venv/bin/python /home/ubuntu/Trading/scripts/coindcx_venue_recorder.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target